from flask import Flask, request, jsonify
from flask_cors import CORS

app = Flask(__name__)
CORS(app)

@app.route('/')
def home():
    return jsonify({"message": "Early Disease Prediction Backend is running!"})

@app.route('/predict/diabetes', methods=['POST'])
def predict_diabetes():
    return jsonify({"disease": "Diabetes", "risk_level": "Medium", "score": 65})

@app.route('/predict/heart', methods=['POST'])
def predict_heart():
    return jsonify({"disease": "Heart Disease", "risk_level": "Low", "score": 25})

@app.route('/predict/bp', methods=['POST'])
def predict_bp():
    return jsonify({"disease": "Hypertension", "risk_level": "High", "score": 82})

if __name__ == '__main__':
    app.run(debug=True, port=5000)
